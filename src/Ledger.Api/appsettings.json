{
  "AllowedHosts": "*",
  "Postgres": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "ledger",
    "SslMode": "Disable",
    "IncludeErrorDetail": false,
    "Sources": {
      "Write": { "Username": "ledger_api", "MaxPoolSize": 7, "MinPoolSize": 2, "ConnectionTimeoutSeconds": 1, "CommandTimeoutSeconds": 2, "LockTimeoutMs": 1000, "StatementTimeoutMs": 2500, "IdleInTransactionTimeoutMs": 5000, "ReadOnly": false },
      "Balance": { "Username": "ledger_api", "MaxPoolSize": 8, "MinPoolSize": 2, "ConnectionTimeoutSeconds": 1, "CommandTimeoutSeconds": 1, "StatementTimeoutMs": 1500, "IdleInTransactionTimeoutMs": 5000, "ReadOnly": true },
      "Statement": { "Username": "ledger_api", "MaxPoolSize": 4, "MinPoolSize": 1, "ConnectionTimeoutSeconds": 1, "CommandTimeoutSeconds": 1, "StatementTimeoutMs": 1500, "IdleInTransactionTimeoutMs": 5000, "ReadOnly": true }
    }
  },
  "Authentication": {
    "Mode": "Authority",
    "Authority": "https://auth.bank.internal",
    "Issuer": "https://auth.bank.internal",
    "Audience": "ledger-api",
    "RequireHttpsMetadata": true
  },
  "Security": {
    "ForwardedHeaders": { "KnownNetworks": [] }
  },
  "RateLimiting": {
    "Enabled": true,
    "WritePerClient": { "Capacity": 3000, "RefillPerSecond": 1500 },
    "ReadPerClient": { "Capacity": 12000, "RefillPerSecond": 8000 },
    "WritePerAccount": { "Capacity": 100, "RefillPerSecond": 50 },
    "WriteConcurrency": 16,
    "BalanceConcurrency": 16,
    "StatementConcurrency": 8
  },
  "Ledger": {
    "OccurredAtFutureToleranceMinutes": 5,
    "Balance": { "SettlingWindowSeconds": 5 },
    "Statement": { "DefaultLimit": 50, "MaxLimit": 200 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Ledger.Audit": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Npgsql": "Warning"
      }
    }
  }
}
