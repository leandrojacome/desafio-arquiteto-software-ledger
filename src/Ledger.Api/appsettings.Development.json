{
  "Postgres": {
    "IncludeErrorDetail": true
  },
  "Authentication": {
    "Mode": "LocalKey",
    "Issuer": "https://idp.local.test",
    "RequireHttpsMetadata": false,
    "MaxTokenLifetimeMinutes": 240,
    "LocalKey": {
      "PublicKeyPath": "../../.local/keys/dev-public.pem"
    }
  },
  "Authorization": {
    "AccountProvisioningClients": [ "*" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
