{
  "Postgres": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "ledger",
    "SslMode": "Disable",
    "IncludeErrorDetail": false,
    "Sources": {
      "Worker": { "Username": "ledger_worker", "MaxPoolSize": 5, "MinPoolSize": 1, "ConnectionTimeoutSeconds": 5, "CommandTimeoutSeconds": 10, "LockTimeoutMs": 1000, "StatementTimeoutMs": 10000, "IdleInTransactionTimeoutMs": 15000, "ReadOnly": false },
      "Migrator": { "Username": "ledger_migrator", "MaxPoolSize": 2, "MinPoolSize": 0, "ConnectionTimeoutSeconds": 5, "CommandTimeoutSeconds": 300, "StatementTimeoutMs": 300000, "IdleInTransactionTimeoutMs": 300000, "ReadOnly": false }
    }
  },
  "Migrations": { "LockTimeoutSeconds": 120 },
  "Resilience": {
    "ShutdownTimeoutSeconds": 30,
    "Health": { "ProbeTimeoutSeconds": 1, "CacheSeconds": 5, "RetryAfterSeconds": 5, "OutboxHeartbeatSeconds": 120, "IntegrityHeartbeatMinutes": 30, "OutboxLagSeconds": 60 },
    "BrokerCircuitBreaker": { "FailureRatio": 0.5, "SamplingSeconds": 30, "MinimumThroughput": 10, "BreakSeconds": 30 }
  },
  "RabbitMq": { "Host": "localhost", "Port": 5672, "VirtualHost": "/", "Username": "ledger_worker", "UseTls": false, "ConnectTimeoutSeconds": 2, "Exchange": "ledger.events", "ReconnectMinSeconds": 1, "ReconnectMaxSeconds": 30, "ReconnectJitterPercent": 20,
    "Retention": { "Enabled": true, "Queue": "retention.ledger.entry-registered", "TtlHours": 24, "MaxLength": 1000000, "MaxMegabytes": 1024, "DeadLetterTtlHours": 168, "DeadLetterMaxLength": 100000 }
  },
  "Outbox": {
    "BatchSize": 200,
    "IdlePollMs": 200,
    "LeaseSeconds": 30,
    "ConfirmTimeoutSeconds": 5,
    "RetentionDays": 7,
    "PruneIntervalMinutes": 10,
    "PruneBatchSize": 5000,
    "MeasureIntervalSeconds": 10,
    "PendingCap": 1000000,
    "FailedAttempts": 5,
    "FailedHeadWindow": 1000
  },
  "Worker": {
    "FailureBackoff": { "MinSeconds": 1, "MaxSeconds": 30 }
  },
  "Idempotency": { "RetentionDays": 35, "PruneIntervalMinutes": 10, "PruneBatchSize": 5000 },
  "Integrity": { "RecentIntervalMinutes": 5, "RecentOverlapMinutes": 1, "FullIntervalHours": 24, "HeadBatchSize": 5000, "ChainSliceMinutes": 10 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Npgsql": "Warning"
      }
    }
  }
}
